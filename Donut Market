<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DonutSMP Stock Market Dashboard - ZenoxIsHere1</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN for Stock Charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- FontAwesome for UI icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .pixelated { image-rendering: pixelated; }

    /* Liquid Lava-Lamp Background Animation */
    body {
      background-color: #020617;
      overflow-x: hidden;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .liquid-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      z-index: -1;
      filter: blur(120px);
      opacity: 0.6;
    }

    .liquid-blob {
      position: absolute;
      border-radius: 50%;
      will-change: transform;
      mix-blend-mode: screen;
      animation: floatLiquid 18s infinite alternate ease-in-out;
    }

    .blob-1 {
      width: 650px;
      height: 650px;
      background: rgba(245, 158, 11, 0.4);
      top: -20%;
      left: -10%;
    }

    .blob-2 {
      width: 750px;
      height: 750px;
      background: rgba(16, 185, 129, 0.3);
      bottom: -25%;
      right: -10%;
      animation-delay: -4s;
    }

    .blob-3 {
      width: 550px;
      height: 550px;
      background: rgba(99, 102, 241, 0.35);
      top: 25%;
      left: 30%;
      animation-delay: -8s;
    }

    @keyframes floatLiquid {
      0% { transform: translate(0px, 0px) scale(1) rotate(0deg); }
      33% { transform: translate(120px, 80px) scale(1.15) rotate(45deg); }
      66% { transform: translate(-80px, 140px) scale(0.9) rotate(90deg); }
      100% { transform: translate(60px, -90px) scale(1.1) rotate(135deg); }
    }

    /* Glassmorphism Panels */
    .glass-panel {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.5));
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    @keyframes glowPulse {
      0%, 100% { text-shadow: 0 0 20px rgba(245, 158, 11, 0.6), 0 0 40px rgba(245, 158, 11, 0.3); }
      50% { text-shadow: 0 0 35px rgba(245, 158, 11, 0.9), 0 0 70px rgba(245, 158, 11, 0.5); }
    }
    .mega-glow {
      animation: glowPulse 4s infinite ease-in-out;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.4);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(245, 158, 11, 0.4);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(245, 158, 11, 0.8);
    }
  </style>
</head>
<body class="text-slate-100 min-h-screen p-4 md:p-6 transition-all duration-300">

  <!-- Liquid Lava-Lamp Background Container -->
  <div class="liquid-container">
    <div class="liquid-blob blob-1"></div>
    <div class="liquid-blob blob-2"></div>
    <div class="liquid-blob blob-3"></div>
  </div>

  <!-- Header Hero Section -->
  <header class="w-full max-w-[1700px] mx-auto glass-panel rounded-3xl p-5 md:p-6 mb-4 flex flex-col lg:flex-row justify-between items-center gap-4 relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 text-amber-500/5 text-9xl pointer-events-none">
      <i class="fa-solid fa-chart-line"></i>
    </div>

    <div class="text-center lg:text-left z-10">
      <!-- Clickable YouTube Channel Badge -->
      <a href="https://www.youtube.com/@Zenoxishere1" target="_blank" rel="noopener noreferrer" 
         class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-2 shadow-sm hover:bg-red-500/20 hover:border-red-500/50 transition-all duration-200 cursor-pointer">
        <i class="fa-brands fa-youtube text-red-500 text-sm"></i> ZenoxIsHere1
      </a>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-amber-400 tracking-tight uppercase mega-glow">
        Stock Market
      </h1>
      <p class="text-slate-300 text-xs md:text-sm mt-1 max-w-xl">
        Real-time tracking of Auction House item values, live pricing trends, and 24-hour market shifts.
      </p>
    </div>
    
    <div class="flex flex-wrap items-center justify-center lg:justify-end gap-3 w-full lg:w-auto bg-slate-950/60 p-3 rounded-2xl border border-slate-800/80 shadow-inner z-10">
      
      <!-- Live Real API Player Balance Box -->
      <div class="bg-slate-900/90 border border-slate-700/80 rounded-xl px-3 py-2 flex flex-col justify-center items-center sm:items-start min-w-[120px] backdrop-blur-md shadow-inner">
        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold"><i class="fa-solid fa-coins text-amber-400"></i> Live Balance</span>
        <span id="playerBalance" class="text-sm font-black text-amber-400 font-mono">$0.00</span>
      </div>

      <div class="relative w-full sm:w-auto">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
          <i class="fa-solid fa-user text-xs"></i>
        </span>
        <input id="gameId" type="text" placeholder="Minecraft Username" 
               class="bg-slate-900/90 border border-slate-700/80 rounded-xl pl-9 pr-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500 w-full sm:w-44 transition-all duration-200 focus:ring-2 focus:ring-amber-500/30 backdrop-blur-md shadow-inner"
               oninput="updateHeadDirectly(this.value)"
               onkeypress="if(event.key === 'Enter') linkAccount()">
      </div>
      
      <button id="linkBtn" onclick="linkAccount()" 
              class="bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 active:scale-95 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition-all duration-200 whitespace-nowrap shadow-lg shadow-amber-600/30 flex items-center gap-2">
        <i class="fa-solid fa-link"></i> Link & Fetch
      </button>

      <button id="unlinkBtn" onclick="unlinkAccount()" 
              class="hidden bg-rose-950/80 border border-rose-800/80 text-rose-300 hover:bg-rose-900 active:scale-95 font-bold text-xs px-3 py-2.5 rounded-xl transition-all duration-200 whitespace-nowrap backdrop-blur-md flex items-center gap-2">
        <i class="fa-solid fa-unlink"></i> Unlink
      </button>

      <div class="relative w-12 h-12 bg-slate-900/90 rounded-xl border-2 border-amber-500/80 p-1 flex items-center justify-center shadow-lg overflow-hidden shrink-0 transition-transform duration-300 hover:scale-105 backdrop-blur-md" title="Player Head Skin">
        <img id="playerHead" 
             src="https://minotar.net/avatar/Steve/64.png" 
             onerror="this.src='https://mc-heads.net/avatar/Steve/64.png'"
             alt="Head" 
             class="w-10 h-10 rounded-lg pixelated">
      </div>
    </div>
  </header>

  <!-- Sub-Bar Status Info -->
  <div class="w-full max-w-[1700px] mx-auto mb-4 flex flex-wrap items-center justify-between px-3 gap-2">
    <div class="flex items-center gap-2">
      <span class="text-xs text-slate-400">Account Status:</span>
      <span id="statusBadge" class="text-xs font-bold bg-slate-900/80 text-slate-300 border border-slate-700/80 px-3 py-1 rounded-full backdrop-blur-md shadow-inner flex items-center gap-1.5">
        <i class="fa-solid fa-circle text-[6px] text-slate-400"></i> Guest (Not Linked)
      </span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs text-slate-400"><i class="fa-regular fa-clock"></i> Next Market Update:</span>
      <span id="countdown" class="font-mono text-amber-400 font-bold text-xs tracking-wider animate-pulse">24:00:00</span>
    </div>
  </div>

  <!-- Main Grid Layout: Side-by-Side -->
  <main class="w-full max-w-[1700px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-5">

    <!-- Left Side: Live Items Table (7 Columns) -->
    <section class="lg:col-span-7 glass-panel rounded-3xl p-5 md:p-6 transition-all duration-300 flex flex-col justify-between">
      <div>
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg md:text-xl font-bold text-slate-100 flex items-center gap-2">
            <i class="fa-solid fa-table-list text-amber-400"></i> Live Item Listings
          </h2>
          <span class="text-xs text-amber-400/90 font-medium bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20">
            <i class="fa-solid fa-bolt"></i> Click row to update chart
          </span>
        </div>

        <div class="overflow-x-auto max-h-[440px] overflow-y-auto pr-1">
          <table class="w-full text-left border-collapse text-sm">
            <thead class="sticky top-0 bg-slate-900/95 backdrop-blur-md z-10 shadow-md">
              <tr class="border-b border-slate-700/60 text-slate-400 text-xs uppercase tracking-wider">
                <th class="py-2.5 px-3">Item</th>
                <th class="py-2.5 px-3">Avg Price</th>
                <th class="py-2.5 px-3">Lowest AH</th>
                <th class="py-2.5 px-3">24h Trend</th>
                <th class="py-2.5 px-3">Action</th>
              </tr>
            </thead>
            <tbody id="marketTable" class="divide-y divide-slate-700/40">
              <!-- Rows injected by JavaScript -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Right Side: Interactive Chart & Stats (5 Columns) -->
    <section class="lg:col-span-5 glass-panel rounded-3xl p-5 md:p-6 flex flex-col justify-between transition-all duration-300">
      <div>
        <div class="flex justify-between items-center mb-1">
          <h2 class="text-base md:text-lg font-black text-amber-400 tracking-wide uppercase mega-glow flex items-center gap-2">
            <i class="fa-solid fa-chart-area"></i> Value Analytics
          </h2>
          <span id="trendBadge" class="text-xs text-emerald-400 font-semibold bg-emerald-950/80 border border-emerald-800/80 px-2 py-0.5 rounded-lg transition-all duration-300 backdrop-blur-md">
            +12.4%
          </span>
        </div>
        
        <h3 id="chartTitle" class="text-sm font-bold text-slate-200 mb-3">Elytra Price Trend</h3>
        
        <div class="relative w-full h-56 md:h-64 bg-slate-950/50 rounded-2xl p-2 border border-slate-800 shadow-inner">
          <canvas id="priceChart"></canvas>
        </div>
      </div>

      <!-- Quick Market Stats -->
      <div class="grid grid-cols-2 gap-3 mt-4 text-center">
        <div class="bg-slate-950/60 border border-slate-800/80 p-3 rounded-2xl transition-transform duration-200 hover:scale-105 backdrop-blur-md shadow-inner">
          <span class="text-xs text-slate-400 block mb-1">Selected Lowest AH</span>
          <span id="statLowestAH" class="text-base md:text-lg font-extrabold text-amber-400">$343.0M</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 p-3 rounded-2xl transition-transform duration-200 hover:scale-105 backdrop-blur-md shadow-inner">
          <span class="text-xs text-slate-400 block mb-1">7-Day High</span>
          <span id="statHighPrice" class="text-base md:text-lg font-extrabold text-emerald-400">$350.0M</span>
        </div>
      </div>
    </section>

  </main>

  <!-- JavaScript Logic -->
  <script>
    let marketItems = [
      { 
        name: 'Elytra', 
        icon: 'https://minecraft.wiki/images/Elytra.png',
        avgPrice: 350000000, 
        lowestAH: 343000000, 
        trend: +12.4, 
        history: [290000000, 300000000, 310000000, 325000000, 335000000, 343000000, 350000000] 
      },
      { 
        name: 'Netherite Ingot', 
        icon: 'https://minecraft.wiki/images/Netherite_Ingot.png',
        avgPrice: 3800000, 
        lowestAH: 3720000, 
        trend: -3.1, 
        history: [4100000, 4000000, 3950000, 3880000, 3800000, 3750000, 3720000] 
      },
      { 
        name: 'Enchanted Golden Apple', 
        icon: 'https://minecraft.wiki/images/Enchanted_Golden_Apple.gif',
        avgPrice: 1600000, 
        lowestAH: 1570000, 
        trend: +5.8, 
        history: [1350000, 1400000, 1450000, 1500000, 1520000, 1550000, 1570000] 
      },
      { 
        name: 'Dragon Head', 
        icon: 'https://minecraft.wiki/images/Dragon_Head_%28item%29.png',
        avgPrice: 79900000, 
        lowestAH: 66500000, 
        trend: +18.2, 
        history: [55000000, 58000000, 60000000, 62000000, 64000000, 66500000, 79900000] 
      },
      { 
        name: 'Nether Star', 
        icon: 'https://minecraft.wiki/images/Nether_Star.gif',
        avgPrice: 12500000, 
        lowestAH: 12100000, 
        trend: +2.4, 
        history: [11000000, 11300000, 11500000, 11800000, 12000000, 12050000, 12100000] 
      },
      { 
        name: 'Mob Spawner', 
        icon: 'https://minecraft.wiki/images/Monster_Spawner_%28Item%29.png',
        avgPrice: 850000000, 
        lowestAH: 820000000, 
        trend: +7.5, 
        history: [750000000, 770000000, 780000000, 795000000, 810000000, 815000000, 820000000] 
      },
      { 
        name: 'Beacon', 
        icon: 'https://minecraft.wiki/images/Beacon.png',
        avgPrice: 18000000, 
        lowestAH: 17500000, 
        trend: -1.2, 
        history: [18500000, 18300000, 18100000, 17900000, 17800000, 17600000, 17500000] 
      },
      { 
        name: 'Shulker Box', 
        icon: 'https://minecraft.wiki/images/Shulker_Box.png',
        avgPrice: 4500000, 
        lowestAH: 4300000, 
        trend: +4.1, 
        history: [3900000, 4000000, 4100000, 4150000, 4200000, 4250000, 4300000] 
      },
      { 
        name: 'Totem of Undying', 
        icon: 'https://minecraft.wiki/images/Totem_of_Undying.png',
        avgPrice: 75000, 
        lowestAH: 72000, 
        trend: -1.5, 
        history: [85000, 82000, 78000, 76000, 74000, 73000, 72000] 
      }
    ];

    let chartInstance = null;
    let selectedIndex = 0;
    
    const REFRESH_DURATION_MS = 24 * 60 * 60 * 1000;
    let targetRefreshTime = localStorage.getItem('donut_next_refresh');

    if (!targetRefreshTime || Date.now() > targetRefreshTime) {
      targetRefreshTime = Date.now() + REFRESH_DURATION_MS;
      localStorage.setItem('donut_next_refresh', targetRefreshTime);
    }

    function formatCurrency(value) {
      if (value >= 1e9) return '$' + (value / 1e9).toFixed(1) + 'B';
      if (value >= 1e6) return '$' + (value / 1e6).toFixed(1) + 'M';
      if (value >= 1e3) return '$' + (value / 1e3).toFixed(0) + 'k';
      return '$' + value;
    }

    async function fetchRealPlayerBalance(username) {
      const balanceEl = document.getElementById('playerBalance');
      balanceEl.innerText = "Loading...";

      try {
        const response = await fetch(`https://api.donutsmp.net/v1/lookup/${encodeURIComponent(username)}`);
        if (!response.ok) {
          throw new Error("Player not found or offline");
        }
        const data = await response.json();
        
        if (data && data.result && data.result.money) {
          const actualMoney = parseFloat(data.result.money);
          balanceEl.innerText = formatCurrency(actualMoney);
        } else {
          balanceEl.innerText = "$0.00";
        }
      } catch (error) {
        console.warn("Could not fetch real API balance:", error);
        balanceEl.innerText = "API Offline";
      }
    }

    function setPlayerHead(username) {
      const cleanName = username.trim() || 'Steve';
      const headImg = document.getElementById('playerHead');
      
      headImg.onerror = function() {
        this.src = `https://mc-heads.net/avatar/${encodeURIComponent(cleanName)}/64.png`;
      };
      headImg.src = `https://minotar.net/avatar/${encodeURIComponent(cleanName)}/64.png`;
    }

    function updateHeadDirectly(username) {
      if (username.trim().length > 0) {
        setPlayerHead(username);
      } else {
        setPlayerHead('Steve');
        document.getElementById('playerBalance').innerText = '$0.00';
      }
    }

    function loadSavedAccount() {
      const savedUser = localStorage.getItem('donut_username');

      if (savedUser) {
        document.getElementById('gameId').value = savedUser;
        
        const badge = document.getElementById('statusBadge');
        badge.innerHTML = `<i class="fa-solid fa-circle text-[6px] text-emerald-400"></i> Linked: ${savedUser}`;
        badge.className = 'text-xs font-bold bg-emerald-950/80 text-emerald-400 border border-emerald-800/80 px-3 py-1 rounded-full backdrop-blur-md flex items-center gap-1.5';

        setPlayerHead(savedUser);
        fetchRealPlayerBalance(savedUser);

        document.getElementById('linkBtn').classList.add('hidden');
        document.getElementById('unlinkBtn').classList.remove('hidden');
      }
    }

    function linkAccount() {
      const username = document.getElementById('gameId').value.trim();
      if (!username) {
        alert("Please enter a valid Minecraft Username.");
        return;
      }
      localStorage.setItem('donut_username', username);
      loadSavedAccount();
    }

    function unlinkAccount() {
      localStorage.removeItem('donut_username');
      document.getElementById('gameId').value = '';
      
      const badge = document.getElementById('statusBadge');
      badge.innerHTML = '<i class="fa-solid fa-circle text-[6px] text-slate-400"></i> Guest (Not Linked)';
      badge.className = 'text-xs font-bold bg-slate-900/80 text-slate-300 border border-slate-700/80 px-3 py-1 rounded-full backdrop-blur-md flex items-center gap-1.5';

      setPlayerHead('Steve');
      document.getElementById('playerBalance').innerText = '$0.00';
      
      document.getElementById('linkBtn').classList.remove('hidden');
      document.getElementById('unlinkBtn').classList.add('hidden');
    }

    function renderTable() {
      const tableBody = document.getElementById('marketTable');
      tableBody.innerHTML = '';

      marketItems.forEach((item, index) => {
        const isPositive = item.trend >= 0;
        const trendClass = isPositive ? 'text-emerald-400' : 'text-rose-400';
        const trendSymbol = isPositive ? '<i class="fa-solid fa-caret-up"></i>' : '<i class="fa-solid fa-caret-down"></i>';
        const isSelected = index === selectedIndex 
          ? 'bg-slate-800/80 border-l-4 border-amber-500 shadow-lg backdrop-blur-md' 
          : 'hover:bg-slate-800/40';

        const row = `
          <tr onclick="selectItem(${index})" class="cursor-pointer transition-all duration-200 transform ${isSelected}">
            <td class="py-3 px-3 font-semibold text-slate-100 flex items-center gap-2.5">
              <div class="w-8 h-8 bg-slate-900/90 rounded-lg p-1 border border-slate-700/60 flex items-center justify-center shrink-0 shadow-inner">
                <img src="${item.icon}" alt="${item.name}" class="w-6 h-6 object-contain pixelated" onerror="this.src='https://minecraft.wiki/images/Barrier.png'">
              </div>
              <span class="truncate">${item.name}</span>
            </td>
            <td class="py-3 px-3 text-slate-300">${formatCurrency(item.avgPrice)}</td>
            <td class="py-3 px-3 text-amber-400 font-mono">${formatCurrency(item.lowestAH)}</td>
            <td class="py-3 px-3 font-bold ${trendClass}">${trendSymbol} ${Math.abs(item.trend)}%</td>
            <td class="py-3 px-3">
              <button class="text-xs bg-slate-800 hover:bg-amber-600 active:scale-95 text-slate-200 hover:text-white px-3 py-1 rounded-lg transition-all duration-150 border border-slate-700/60 shadow-sm flex items-center gap-1">
                <i class="fa-solid fa-chart-line text-[9px]"></i> View
              </button>
            </td>
          </tr>
        `;
        tableBody.innerHTML += row;
      });
    }

    function renderChart(item) {
      document.getElementById('chartTitle').innerText = `${item.name} Price Trend`;
      
      const badge = document.getElementById('trendBadge');
      const isPositive = item.trend >= 0;
      badge.innerHTML = `${isPositive ? '+' : ''}${item.trend}%`;
      badge.className = isPositive 
        ? 'text-xs text-emerald-400 font-semibold bg-emerald-950/80 border border-emerald-800/80 px-2.5 py-0.5 rounded-lg transition-all duration-300 backdrop-blur-md'
        : 'text-xs text-rose-400 font-semibold bg-rose-950/80 border border-rose-800/80 px-2.5 py-0.5 rounded-lg transition-all duration-300 backdrop-blur-md';

      document.getElementById('statLowestAH').innerText = formatCurrency(item.lowestAH);
      document.getElementById('statHighPrice').innerText = formatCurrency(Math.max(...item.history));

      const ctx = document.getElementById('priceChart').getContext('2d');

      if (chartInstance) {
        chartInstance.destroy();
      }

      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Today'],
          datasets: [{
            label: `${item.name} Price`,
            data: item.history,
            borderWidth: 2.5,
            tension: 0.35,
            fill: true,
            backgroundColor: 'rgba(245, 158, 11, 0.1)',
            segment: {
              borderColor: ctx => {
                const prev = ctx.p0.parsed.y;
                const curr = ctx.p1.parsed.y;
                return curr >= prev ? '#10b981' : '#f43f5e';
              }
            }
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 800,
            easing: 'easeOutQuart'
          },
          plugins: { 
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ` Price: ${formatCurrency(context.raw)}`;
                }
              }
            }
          },
          scales: {
            x: { grid: { color: 'rgba(255, 255, 255, 0.04)' }, ticks: { color: '#94a3b8', font: { size: 10 } } },
            y: { 
              grid: { color: 'rgba(255, 255, 255, 0.04)' }, 
              ticks: { 
                color: '#94a3b8',
                font: { size: 10 },
                callback: function(value) {
                  return formatCurrency(value);
                }
              } 
            }
          }
        }
      });
    }

    function selectItem(index) {
      selectedIndex = index;
      renderTable();
      renderChart(marketItems[index]);
    }

    function updateCountdown() {
      const now = Date.now();
      let remainingMs = Math.max(0, targetRefreshTime - now);

      if (remainingMs === 0) {
        targetRefreshTime = Date.now() + REFRESH_DURATION_MS;
        localStorage.setItem('donut_next_refresh', targetRefreshTime);
        remainingMs = REFRESH_DURATION_MS;
      }

      const hours = Math.floor(remainingMs / (1000 * 60 * 60));
      const minutes = Math.floor((remainingMs % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((remainingMs % (1000 * 60)) / 1000);

      document.getElementById('countdown').innerText = 
        String(hours).padStart(2, '0') + ':' + 
        String(minutes).padStart(2, '0') + ':' + 
        String(seconds).padStart(2, '0');
    }

    renderTable();
    renderChart(marketItems[0]);
    loadSavedAccount();
    setInterval(updateCountdown, 1000);
  </script>
</body>
</html>
